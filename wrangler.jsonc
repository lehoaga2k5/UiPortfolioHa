{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lehoanganh-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "lehoanganh.id.vn",
      "custom_domain": true
    },
    {
      "pattern": "www.lehoanganh.id.vn",
      "custom_domain": true
    }
  ]
}
